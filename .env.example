# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# Ollama Model Name (e.g., llama3, mistral)
OLLAMA_MODEL=llama3

# Vector Store Configuration
CHROMA_PERSIST_DIR=./chroma_db

# Document Ingestion Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval Configuration
TOP_K_RESULTS=5

# Contextual compression (LLMChainExtractor) — "true" trims irrelevant sentences
# from retrieved chunks before the LLM sees them. Set "false" to save latency/cost.
ENABLE_COMPRESSION=true

# CORS — comma-separated list of allowed origins for the FastAPI backend
ALLOWED_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# Auth — hours a session_id stays valid without use before requiring re-login
SESSION_TTL_HOURS=168
